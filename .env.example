# =============================================================================
# Jeopardy Management & Predictive SLA Tracker — Local Environment Defaults
# Copy to .env to customize ports, credentials, or sizing locally:
#   cp .env.example .env
# =============================================================================

# --- Apache Kafka (KRaft Mode — Zero Zookeeper) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_UI_PORT=8085

# --- PostgreSQL 16 (Operational Hot Store) ---
POSTGRES_DB=jeopardy
POSTGRES_USER=jeopardy
POSTGRES_PASSWORD=jeopardy
POSTGRES_PORT=5432
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/jeopardy

# --- ClickHouse OSS (Raw Audit, Telemetry & OLAP Materialized Views) ---
CLICKHOUSE_DB=jeopardy
CLICKHOUSE_USER=jeopardy
CLICKHOUSE_PASSWORD=jeopardy
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_URL=http://localhost:8123

# --- Apache Flink 1.20 (Java 21 + Embedded RocksDB) ---
FLINK_UI_PORT=8081
FLINK_TASK_SLOTS=2

# --- Optional Profile: cache (--profile cache) — Valkey 8 OSS ---
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

# --- Optional Profile: bi (--profile bi) — Grafana OSS ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
